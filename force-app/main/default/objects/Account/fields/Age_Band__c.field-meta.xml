<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Age_Band__c</fullName>
    <description>Calculated from date of birth. Staff only.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(PersonBirthdate), &quot;Unknown&quot;, IF(ADDMONTHS(PersonBirthdate, 216) &lt;= TODAY(), &quot;18+&quot;, IF(ADDMONTHS(PersonBirthdate, 192) &lt;= TODAY(), &quot;16-17&quot;, &quot;Under 16&quot;)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculated from date of birth. Staff only.</inlineHelpText>
    <label>Age Band</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
